# FYERS API app ID and access token from the FYERS developer portal
FYERS_APP_ID=your_app_id
FYERS_ACCESS_TOKEN=your_access_token
# Use the exact FYERS symbol accepted by your account/API, e.g. NSE:NIFTY50-INDEX
FYERS_SYMBOL=NSE:NIFTY50-INDEX
# Candle timeframe in minutes; EMA logic is evaluated on completed candles
FYERS_RESOLUTION=5
POLL_SECONDS=30
HISTORY_DAYS=10
# Telegram BotFather token and target chat/channel ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Set false to only validate/fetch data without sending Telegram alerts
TELEGRAM_ENABLED=true
